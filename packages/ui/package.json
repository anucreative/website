{
  "name": "@website/ui",
  "version": "1.0.0",
  "description": "Design system components and tokens",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    },
    "./global.css": "./dist/assets/global.css"
  },
  "scripts": {
    "dev": "yarn build",
    "build:tokens": "tsx ./scripts/translate-tokens.ts",
    "build:assets": "mkdir -p dist/assets && cp src/global.css dist/assets/global.css",
    "build": "tsc --build && yarn build:tokens && yarn build:assets",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/lodash.merge": "^4",
    "@types/node": "^20.10.6",
    "lodash.merge": "^4.6.2",
    "style-dictionary": "^5.1.3",
    "tsx": "^4.21.0"
  }
}
