{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@website/*": ["../../apps/*", "../../packages/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
