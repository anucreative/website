{
  "name": "@website/components",
  "version": "1.0.0",
  "description": "Design system components and tokens",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./global.css": "./dist/assets/global.css"
  },
  "scripts": {
    "build:tokens": "tsx ./scripts/translate-tokens.ts",
    "build:assets": "mkdir -p dist/assets && cp src/global.css dist/assets/global.css",
    "build": "tsc --build && yarn build:tokens && yarn build:assets",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-vitest": "^10.1.4",
    "@storybook/web-components": "^10.1.4",
    "@storybook/web-components-vite": "^10.1.4",
    "@types/lodash.merge": "^4",
    "@types/node": "^20.10.6",
    "lit": "^3.1.0",
    "lodash.merge": "^4.6.2",
    "storybook": "^10.1.4",
    "style-dictionary": "^5.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.14"
  }
}
