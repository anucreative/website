{
  "name": "@website/react",
  "version": "1.0.0",
  "description": "TanStack Start full-stack React app with CV pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "assets:sync": "tsx scripts/sync-assets.ts",
    "build": "yarn assets:sync && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "type-check": "tsc --noEmit",
    "test": "DEBUG_PRINT_LIMIT=Infinity vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "clean": "rm -rf .output dist .turbo",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-router": "^1.139.14",
    "@tanstack/react-start": "^1.139.14",
    "@website/data-types": "workspace:*",
    "@website/msw": "workspace:*",
    "@website/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/react-vite": "^10.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^27",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.1.11",
    "jsdom": "^27.2.0",
    "storybook": "^10.1.4",
    "tsx": "^4.21.0"
  }
}
